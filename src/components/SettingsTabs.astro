---
/**
 * Settings — WAI-ARIA tabs (automatic activation).
 * Keyboard: ←/→ move between tabs, Home/End jump, Tab moves into the panel.
 * Tabs/rows arrive pre-filtered from lib/content.ts (unknown values never render).
 */
import Icon from "./Icon.astro";
import CrosshairPreview from "./CrosshairPreview.astro";
import SectionHeading from "./SectionHeading.astro";
import type { Tab } from "../lib/content";
import type { Profile } from "../lib/types";

interface Props {
  tabs: Tab[];
  crosshair: Profile["crosshair"];
  crosshairCode: string | null;
  /** autoexec.cfg contents, base64-encoded (exact bytes) */
  autoexec: string;
}
const { tabs, crosshair, crosshairCode, autoexec } = Astro.props;
const sensHref = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}sens`;

/** Launch options → wrap-safe groups: each option stays with its value,
 *  e.g. "-fullscreen", "+exec autoexec.cfg", "-allow_third_party_software". */
const launchGroups = (s: string): string[] => {
  const parts = s.trim().split(/\s+/);
  const out: string[] = [];
  for (let i = 0; i < parts.length; i++) {
    const flag = /^[-+]/.test(parts[i]);
    const next = parts[i + 1];
    if (flag && next !== undefined && !/^[-+]/.test(next)) {
      out.push(`${parts[i]} ${next}`);
      i++;
    } else out.push(parts[i]);
  }
  return out;
};
---

<section class="section section--tint" id="settings" data-panel data-label="Settings" aria-labelledby="settings-title">
  <div class="container">
    <SectionHeading id="settings-title" title="Settings" lede="Exactly what I run. Copy what you like." />

    <div class="st card moon-glow" data-tabs>
      <div class="st__tablist-wrap">
        <div class="st__tablist" role="tablist" aria-label="Settings categories">
          {tabs.map((t, i) => (
            <button
              class="st__tab"
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.label}
            </button>
          ))}
        </div>
      </div>

      {tabs.map((t, i) => (
        <div
          class:list={["st__panel", `st__panel--${t.id}`]}
          role="tabpanel"
          id={`panel-${t.id}`}
          aria-labelledby={`tab-${t.id}`}
          tabindex="0"
          hidden={i !== 0}
        >
          {t.id === "crosshair" ? (
            <div class="st__xh">
              <div class="st__xh-preview">
                <CrosshairPreview {...crosshair}>
                  {crosshairCode && (
                    <button slot="action" class="btn btn--primary btn--sm st__xh-copy" type="button" data-copy={crosshairCode} data-copy-msg="Crosshair code copied">
                      <Icon name="copy" size={16} /> Copy crosshair code
                    </button>
                  )}
                </CrosshairPreview>
              </div>
              <dl class="kv">
                {t.rows.map((r) => (
                  <div class="kv__row">
                    <dt>{r.label}</dt>
                    <dd>
                      {r.label === "Color" && <span class="kv__swatch" style={`background:${r.value}`} aria-hidden="true" />}
                      {r.kind === "bool" ? <span class:list={["kv__bool", { "is-on": r.on }]}>{r.value}</span> : r.value}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ) : t.id === "launch" && t.code ? (
            <div class="codeblock">
              <pre><code>{launchGroups(t.code).map((g, i) => (<>{i > 0 && " "}<span class="codeblock__tok">{g}</span></>))}</code></pre>
              <button class="btn btn--ghost btn--sm codeblock__copy" type="button" data-copy={t.code} data-copy-msg="Launch options copied">
                <Icon name="copy" size={16} /> Copy
              </button>
            </div>
          ) : t.id === "binds" ? (
            <dl class="kv">
              {t.rows.map((r) => (
                <div class="kv__row">
                  <dt>{r.label}</dt>
                  <dd><kbd class="kv__key">{r.value}</kbd></dd>
                </div>
              ))}
            </dl>
          ) : (
            <>
              <dl class="kv">
                {t.rows.map((r) => (
                  <div class="kv__row">
                    <dt>{r.label}</dt>
                    <dd>{r.kind === "bool" ? <span class:list={["kv__bool", { "is-on": r.on }]}>{r.value}</span> : r.value}</dd>
                  </div>
                ))}
              </dl>
              {t.id === "mouse" && (
                <div class="st__cta">
                  <p>Find your ideal sensitivity: test any CS2 sens 1-to-1 in your browser.</p>
                  <a class="btn btn--primary btn--sm st__cta-btn" href={sensHref}>
                    Open sensitivity tester <Icon name="external" size={16} />
                  </a>
                  <span class="st__cta-mobile">Available on desktop</span>
                </div>
              )}
            </>
          )}
        </div>
      ))}

      <div class="st__foot">
        <button class="btn btn--ghost btn--sm" type="button" data-autoexec={autoexec} data-filename="autoexec.cfg">
          <Icon name="download" size={16} /> Download autoexec.cfg
        </button>
      </div>
    </div>
  </div>
  <slot />
</section>

<style>
  /* Tab bar on the left, Download autoexec.cfg on the right of the same row;
     the active panel spans the full width underneath. */
  .st {
    padding: 8px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }
  .st__tablist-wrap { grid-column: 1; grid-row: 1; }
  .st__foot { grid-column: 2; grid-row: 1; }
  .st__panel { grid-column: 1 / -1; grid-row: 2; align-self: start; }
  /* phones: not enough room beside the tabs, so the button gets its own row under them */
  @media (max-width: 639px) {
    .st__tablist-wrap { grid-column: 1 / -1; }
    .st__foot { grid-column: 1 / -1; grid-row: 2; justify-self: end; }
    .st__panel { grid-row: 3; }
  }
  .st::before { inset: -20% -10%; }

  /* Tab list — scrolls horizontally on narrow screens instead of wrapping */
  .st__tablist-wrap {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent);
    mask-image: linear-gradient(90deg, #000 88%, transparent);
  }
  .st__tablist-wrap::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) {
    .st__tablist-wrap { -webkit-mask-image: none; mask-image: none; }
  }
  .st__tablist {
    display: flex;
    gap: 4px;
    width: max-content;
    padding: 4px;
  }
  .st__tab {
    position: relative;
    min-height: 44px;
    padding: 10px 16px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .st__tab:hover { color: var(--text); background: rgba(185, 166, 255, 0.08); }
  .st__tab[aria-selected="true"] {
    color: var(--cream);
    background: rgba(232, 38, 59, 0.12);
    box-shadow: inset 0 0 0 1px rgba(232, 38, 59, 0.45);
  }
  .st__tab[aria-selected="true"]::after {
    content: "";
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 6px;
    height: 2px;
    background: var(--moon-red);
    transform: skewX(-20deg);
  }

  .st__panel {
    padding: clamp(16px, 3vw, 28px);
    border-radius: 10px;
  }
  .st__panel:focus-visible { outline-offset: -2px; }

  /* Key / value rows */
  .kv {
    margin: 0;
    display: grid;
    gap: 0 40px;
  }
  @media (min-width: 640px) {
    .kv { grid-template-columns: 1fr 1fr; }
  }
  .kv__row {
    display: flex;
    justify-content: space-between;
    align-items: center; /* label (Inter) and value (Share Tech Mono) have different metrics */
    gap: 16px;
    padding: 12px 2px;
    border-bottom: 1px solid var(--border);
  }
  .kv dt { color: var(--text-muted); font-size: 0.9375rem; }
  .kv dd {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-value);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--cream);
    text-align: right;
  }
  .kv__bool {
    padding: 1px 8px;
    border-radius: 6px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-muted);
    border: 1px solid var(--border-strong);
  }
  .kv__bool.is-on { color: var(--moon-red-text); border-color: rgba(232, 38, 59, 0.55); background: rgba(232, 38, 59, 0.08); }
  .kv__swatch { width: 14px; height: 14px; border-radius: 3px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.3); }
  .kv__key {
    font-family: var(--font-value);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
    border-bottom-width: 3px;
    background: rgba(10, 11, 34, 0.5);
  }

  /* Crosshair tab layout */
  .st__xh {
    display: grid;
    gap: 24px;
    align-items: start;
  }
  /* preview spans the card; the settings sit underneath in columns */
  .st__xh .kv { grid-template-columns: 1fr; }
  @media (min-width: 640px) {
    .st__xh .kv { grid-template-columns: 1fr 1fr; gap: 0 32px; }
  }
  @media (min-width: 1024px) {
    .st__xh .kv { grid-template-columns: repeat(3, 1fr); }
  }
  .st__xh-preview { display: grid; gap: 14px; }
  .st__xh-copy { width: 100%; }
  @media (min-width: 640px) {
    .st__xh-copy { width: auto; justify-self: end; }
  }

  /* Code block */
  /* Text wraps instead of scrolling, and the Copy button has its own space
     (beside the text; below it on phones), so they can never overlap.
     The button copies the exact one-line string from data-copy. */
  .codeblock {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 8px 8px 8px 0;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: rgba(6, 7, 22, 0.7);
  }
  .codeblock pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 10px 0 10px 20px;
    white-space: pre-wrap;
    overflow-wrap: anywhere; /* only splits a word if it's longer than the line */
    font: 0.9375rem/1.6 var(--font-mono);
    color: var(--cream);
  }
  /* each option stays in one piece ("-allow_third_party_software" never splits
     at its dash); lines only break between options. An option longer than the
     whole line may still split, so nothing ever overflows. */
  .codeblock__tok { display: inline-block; max-width: 100%; }
  .codeblock__copy { flex: none; }
  @media (max-width: 479px) {
    .codeblock { flex-direction: column; align-items: stretch; gap: 4px; padding: 8px; }
    .codeblock pre { padding: 8px 8px 4px; }
    .codeblock__copy { align-self: flex-end; }
  }

  /* Mouse tab → sensitivity tester */
  .st__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid rgba(232, 38, 59, 0.35);
    background: rgba(232, 38, 59, 0.06);
  }
  .st__cta p { font-size: 0.9375rem; color: var(--cream); }
  .st__cta-mobile {
    display: none;
    font-family: var(--font-value);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  /* touch-only devices: the tester needs a mouse */
  @media (hover: none) and (pointer: coarse) {
    .st__cta-btn { display: none; }
    .st__cta-mobile { display: inline; }
  }

  .st__foot {
    display: flex;
    align-items: center;
    padding: 0 8px 0 12px;
  }
  @media (max-width: 639px) {
    .st__foot { padding: 4px 4px 0; }
  }
</style>

<script>
  /* ---------- ARIA tabs ---------- */
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = true) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls")!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
      tab.scrollIntoView({ block: "nearest", inline: "nearest" });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        let next: number | null = null;
        if (e.key === "ArrowRight") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next !== null) {
          e.preventDefault();
          select(tabs[next]);
        }
      });
    });
  });

  /* ---------- Copy to clipboard ---------- */
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Fallback for non-secure contexts
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.cssText = "position:fixed;opacity:0";
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand("copy");
      ta.remove();
      return ok;
    }
  }
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const ok = await copy(btn.dataset.copy!);
      (window as any).toast?.(ok ? btn.dataset.copyMsg || "Copied" : "Couldn't copy — select it manually");
    });
  });

  /* ---------- autoexec.cfg download (your real file, or one generated from profile.ts) ---------- */
  document.querySelectorAll<HTMLButtonElement>("[data-autoexec]").forEach((btn) => {
    btn.addEventListener("click", () => {
      // base64 → exact original bytes (keeps the file's own line endings)
      const bytes = Uint8Array.from(atob(btn.dataset.autoexec!), (ch) => ch.charCodeAt(0));
      const blob = new Blob([bytes], { type: "text/plain" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = btn.dataset.filename || "autoexec.cfg";
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      (window as any).toast?.("autoexec.cfg downloaded");
    });
  });
</script>
