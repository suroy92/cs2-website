---
/** Large, simple outbound link card with a brand-neutral line icon. */
import Icon, { type IconName } from "./Icon.astro";
import type { LinkKey } from "../lib/types";

interface Props {
  kind: LinkKey;
  label: string;
  url: string;
  display: string;
  hint?: string;
}
const { kind, label, url, display, hint } = Astro.props;

const ICONS: Record<LinkKey, IconName> = {
  steam: "gamepad",
  csstats: "chart",
  youtube: "video",
  faceit: "trophy",
  leetify: "chart",
  twitch: "tv",
  x: "at",
  discord: "message",
};
---

<a class="lc card card--interactive" href={url} title={url} target="_blank" rel="noopener noreferrer">
  <span class="lc__icon"><Icon name={ICONS[kind]} size={26} /></span>
  <span class="lc__text">
    <span class="lc__label">{label}</span>
    {hint && <span class="lc__hint pixel">{hint}</span>}
    <span class="lc__url muted">{display}</span>
  </span>
  <span class="lc__arrow"><Icon name="external" size={20} /></span>
  <span class="sr-only">(opens in a new tab)</span>
</a>

<style>
  .lc {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px;
    text-decoration: none;
    min-width: 0;
  }
  .lc__icon {
    flex: none;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: var(--lilac);
    background: rgba(123, 92, 224, 0.12);
    border: 1px solid var(--border);
    transition: color var(--dur) var(--ease);
  }
  .lc__text { display: grid; gap: 2px; min-width: 0; flex: 1; }
  .lc__label { font-family: var(--font-display); font-weight: 800; font-style: italic; font-size: 1.625rem; line-height: 1.05; color: var(--cream); }
  .lc__hint { font-size: 0.6875rem; color: var(--sakura); text-transform: uppercase; letter-spacing: 0.06em; }
  .lc__url { font-size: 0.875rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lc__arrow { color: var(--text-muted); transition: transform var(--dur) var(--ease), color var(--dur) var(--ease); }
  .lc:hover .lc__arrow { color: var(--moon-red-text); transform: translate(2px, -2px); }
  .lc:hover .lc__icon { color: var(--cream); }
</style>
