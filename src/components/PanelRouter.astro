---
/**
 * PanelRouter — turns the stacked sections into full-screen "pages".
 *
 * Each `main > [data-panel]` is one page. One is visible at a time; moving
 * forward, the current page fades out upward and the next fades in from
 * below (reversed when going back). Reduced motion → a short crossfade.
 *
 * Navigation: any in-page link (#about, #gear…), browser back/forward,
 * shareable URLs (/#gear opens on Gear), mouse wheel / trackpad, swipe,
 * PageUp/PageDown, and the dot indicator (desktop).
 *
 * A page taller than the screen (common on phones) scrolls inside itself
 * first; the wheel/swipe only moves to the next page once you're at its edge.
 *
 * Progressive enhancement: Base.astro adds `js-panels` to <html> from an
 * inline script. Without JS, the sections stack and the page scrolls normally.
 */
---

<!-- Runs as soon as <main> is parsed, so the right page shows on first paint. -->
<script is:inline>
  (function () {
    var d = document.documentElement;
    if (!d.classList.contains("js-panels")) return;
    var ps = document.querySelectorAll("main > [data-panel]");
    if (!ps.length) { d.classList.remove("js-panels"); return; }
    var show = function () {
      var id = location.hash.slice(1), t = ps[0];
      for (var i = 0; i < ps.length; i++) { ps[i].classList.remove("is-active"); if (ps[i].id === id) t = ps[i]; }
      t.classList.add("is-active");
      document.body.dataset.panel = t.id;
      document.body.classList.toggle("is-reading", t !== ps[0]);
      var nav = document.querySelector("[data-nav]");
      if (nav) nav.classList.toggle("is-scrolled", t !== ps[0]);
    };
    show();
    // Fallback until the router module takes over (or if it fails to load).
    window.addEventListener("hashchange", function () { if (!window.__panelRouter) show(); });
  })();
</script>

<style is:global>
  html.js-panels {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none; /* no pull-to-refresh fighting the swipe */
  }
  html.js-panels body {
    height: 100%;
    overflow: hidden;
  }
  html.js-panels main {
    position: fixed;
    inset: 0;
    z-index: 1;
  }

  html.js-panels main > [data-panel] {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(155, 124, 240, 0.35) transparent;
    visibility: hidden;
    background: none;
  }
  html.js-panels main > [data-panel].is-active { visibility: visible; }

  /* Content pages: vertically centered when they fit, top-aligned + scrollable when they don't */
  html.js-panels main > [data-panel]:not(.intro) {
    --panel-pad: clamp(16px, 4vh, 40px);
    padding: calc(var(--nav-h) + var(--panel-pad)) 0 var(--panel-pad);
  }
  html.js-panels main > [data-panel]:not(.intro) > :first-child { margin-top: auto; }
  html.js-panels main > [data-panel]:not(.intro) > :last-child:not(.ft) { margin-bottom: auto; }
  /* the footer sits at the very bottom of the last page */
  html.js-panels main > [data-panel] > .ft {
    margin-top: auto;
    margin-bottom: calc(-1 * var(--panel-pad));
  }
  html.js-panels main > [data-panel] > :nth-last-child(2):has(+ .ft) { margin-bottom: auto; }

  /* Tighter section headings inside pages, so more fits on one screen */
  html.js-panels main > [data-panel] .sh { margin-bottom: clamp(20px, 3vh, 36px); }
  html.js-panels main > [data-panel] .sh__title { font-size: clamp(2.25rem, 4.5vw, 3rem); }

  /* Short desktop/laptop screens: compact pages so each fits without scrolling */
  @media (min-width: 1024px) and (max-height: 1100px) {
    html.js-panels main > [data-panel]:not(.intro) { --panel-pad: 14px; }
    html.js-panels main > [data-panel] .sh { margin-bottom: 16px; }
    html.js-panels main > [data-panel] .sh__title { font-size: 2.25rem; }
    html.js-panels main > [data-panel] .sh__lede { margin-top: 8px; }
    html.js-panels .st__panel { padding-block: 14px; }
    html.js-panels .kv__row { padding-block: 9px; }
    /* the Video tab is the longest list: denser rows so it fits too */
    html.js-panels .st__panel--video .kv__row { padding-block: 6px; }
    html.js-panels .st__panel--video .kv :is(dt, dd) { font-size: 0.875rem; }
    html.js-panels .st__foot { padding-top: 4px; padding-bottom: 12px; }
    html.js-panels .xh__stage { height: clamp(96px, 12vh, 150px); }
    html.js-panels .st__xh { gap: 14px; }
    html.js-panels .st__panel--crosshair .kv__row { padding-block: 6px; }
  }
  @media (min-width: 1024px) and (max-height: 760px) {
    html.js-panels main > [data-panel] .sh__lede { display: none; }
  }
  /* Very short laptop screens: the autoexec button moves up into the tab bar row */
  @media (min-width: 1024px) and (max-height: 800px) {
    html.js-panels .st { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
    html.js-panels .st__tablist-wrap { grid-column: 1; grid-row: 1; }
    html.js-panels .st__foot { grid-column: 2; grid-row: 1; padding: 0 12px 0 0; }
    html.js-panels .st__foot-note { display: none; }
    html.js-panels .st__panel { grid-column: 1 / -1; grid-row: 2; }
    html.js-panels :is(.st__panel--video, .st__panel--crosshair) .kv__row { padding-block: 4px; }
    html.js-panels .st__panel--video .kv :is(dt, dd) { line-height: 1.3; }
    html.js-panels .gear__card { padding-top: 16px; padding-bottom: 16px; }
  }

  /* Headings receive focus after navigation (for screen readers); no ring needed */
  html.js-panels main > [data-panel] :is(h1, h2)[tabindex="-1"]:focus { outline: none; }

  /* ---------- Dot indicator (desktop) ---------- */
  .pdots {
    position: fixed;
    right: clamp(12px, 2vw, 28px);
    top: 50%;
    z-index: 55;
    transform: translateY(-50%);
    display: none;
    flex-direction: column;
    gap: 6px;
  }
  html.js-panels .pdots { display: flex; }
  @media (max-width: 1023px), (max-height: 520px) {
    html.js-panels .pdots { display: none; }
  }
  .pdots button {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    display: grid;
    place-items: center;
  }
  .pdots button::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: rgba(231, 227, 245, 0.35);
    box-shadow: 0 0 0 1px rgba(10, 11, 34, 0.5);
    transition: height var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .pdots button:hover::before { background: var(--cream); }
  .pdots button.is-active::before { height: 18px; background: var(--moon-red); }
</style>

<script>
  /* ============================================================
     Panel router
     ============================================================ */
  const root = document.documentElement;
  const panels = [...document.querySelectorAll<HTMLElement>("main > [data-panel]")];

  if (root.classList.contains("js-panels") && panels.length) {
    (window as any).__panelRouter = true;

    const ids = panels.map((p) => p.id);
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-menu] a[href^='#']")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const baseTitle = document.title;
    const brand = baseTitle.split(" — ")[0];

    let current = Math.max(0, panels.findIndex((p) => p.classList.contains("is-active")));
    let settle: (() => void) | null = null;

    /** Hash → panel index. "" / #top / #main → first page. -1 = not a page. */
    const indexFor = (hash: string) => {
      const id = hash.replace(/^#/, "");
      if (!id || id === "top" || id === "main") return 0;
      return ids.indexOf(id);
    };

    /* ---------- Dot indicator ---------- */
    const dots = document.createElement("nav");
    dots.className = "pdots";
    dots.setAttribute("aria-hidden", "true"); // the main nav is the accessible version
    const dotBtns = panels.map((p, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.tabIndex = -1;
      b.title = p.dataset.label || p.id;
      b.addEventListener("click", () => go(i));
      dots.append(b);
      return b;
    });
    document.body.append(dots);

    /* ---------- Chrome: nav state, veil, title ---------- */
    function syncChrome() {
      const p = panels[current];
      const home = current === 0;
      document.body.dataset.panel = p.id;
      document.body.classList.toggle("is-reading", !home);
      nav?.classList.toggle("is-scrolled", !home);
      for (const a of navLinks) {
        const on = a.hash === `#${p.id}`;
        a.classList.toggle("is-active", on);
        if (on) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      }
      dotBtns.forEach((b, i) => b.classList.toggle("is-active", i === current));
      document.title = home ? baseTitle : `${p.dataset.label} · ${brand}`;
    }

    /** Move focus into the new page so keyboard & screen-reader users follow along. */
    function focusPanel(p: HTMLElement) {
      const h = p.querySelector<HTMLElement>("h1, h2");
      const target = h ?? p;
      if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
      target.focus({ preventScroll: true });
    }

    /* ---------- Transition ---------- */
    const MOVE_MS = 950; // one page turn
    const TRAVEL = 32; // % of the screen height each page travels
    const SCROLL_EASE = "cubic-bezier(0.65, 0, 0.35, 1)"; // ease-in-out, like a smooth scroll

    /* What to fade. Putting opacity on a whole page makes Chrome switch off the
       frosted-glass blur (backdrop-filter) of every card inside it until the
       fade ends — then the blur snaps back, which reads as a jump. So pages
       only MOVE as a whole; opacity goes on each blurred element itself and on
       the largest pieces that contain no blurred element. Computed once per page. */
    const fadeCache = new Map<HTMLElement, Element[]>();
    const isBlurred = (el: Element) => {
      const cs = getComputedStyle(el) as CSSStyleDeclaration & { webkitBackdropFilter?: string };
      const v = cs.backdropFilter || cs.webkitBackdropFilter || "none";
      return v !== "none";
    };
    function fadeTargets(panel: HTMLElement): Element[] {
      const hit = fadeCache.get(panel);
      if (hit) return hit;
      const blurred = [...panel.querySelectorAll("*")].filter(isBlurred);
      const out: Element[] = [];
      const walk = (el: Element) => {
        for (const child of el.children) {
          const inside = blurred.some((b) => b !== child && child.contains(b));
          const ownText = [...child.childNodes].some((n) => n.nodeType === 3 && n.textContent!.trim());
          if (!inside || ownText) out.push(child);
          else walk(child);
        }
      };
      if (blurred.length) walk(panel);
      else out.push(...panel.children);
      fadeCache.set(panel, out);
      return out;
    }

    function go(i: number, { push = true } = {}) {
      if (i < 0 || i >= panels.length) return;
      settle?.(); // finish any transition still running
      if (i === current) {
        panels[i].scrollTo({ top: 0, behavior: reduce.matches ? "auto" : "smooth" });
        return;
      }

      const from = panels[current];
      const to = panels[i];
      const dir = i > current ? 1 : -1; // 1 = forward (out up, in from below)
      current = i;

      if (push) {
        const url = i === 0 ? location.pathname + location.search : `#${to.id}`;
        history.pushState({ panel: to.id }, "", url);
      }
      syncChrome();

      to.scrollTop = 0;
      restTop = 0;
      clearTimeout(restTimer);
      to.classList.add("is-active");
      from.setAttribute("inert", "");

      const anims: Animation[] = [];
      if (reduce.matches) {
        // Reduced motion: a soft crossfade, no movement.
        for (const el of fadeTargets(from))
          anims.push(el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 380, easing: "ease-out", fill: "forwards" }));
        for (const el of fadeTargets(to))
          anims.push(el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 460, delay: 160, easing: "ease-in-out", fill: "both" }));
      } else {
        // Scroll-like: both pages travel together on one smooth ease-in-out
        // curve — the current one rises up and away, the next rises in from
        // below (reversed when going back). Opacity crossfades along the way.
        const motion = { duration: MOVE_MS, easing: SCROLL_EASE, fill: "both" as FillMode };
        anims.push(
          from.animate([{ transform: "translateY(0)" }, { transform: `translateY(${-TRAVEL * dir}%)` }], motion),
          to.animate([{ transform: `translateY(${TRAVEL * dir}%)` }, { transform: "translateY(0)" }], motion),
        );
        const fade = { duration: MOVE_MS, easing: "linear", fill: "both" as FillMode };
        for (const el of fadeTargets(from))
          anims.push(el.animate([{ opacity: 1 }, { opacity: 0, offset: 0.62, easing: "ease-in" }, { opacity: 0 }], fade));
        for (const el of fadeTargets(to))
          anims.push(el.animate([{ opacity: 0 }, { opacity: 0, offset: 0.14 }, { opacity: 1, easing: "ease-out" }], fade));
      }

      const done = () => {
        if (settle !== done) return;
        settle = null;
        for (const a of anims) a.cancel();
        if (panels[current] !== from) from.classList.remove("is-active");
        from.removeAttribute("inert");
      };
      settle = done;
      Promise.all(anims.map((a) => a.finished)).then(done, () => {}); // cancelled = interrupted; settle() already cleaned up

      focusPanel(to);
    }

    /* ---------- In-page links ---------- */
    document.addEventListener("click", (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element).closest<HTMLAnchorElement>("a[href^='#']");
      if (!a) return;
      const href = a.getAttribute("href")!;
      if (href === "#main") {
        // skip link → jump into the current page's content
        e.preventDefault();
        focusPanel(panels[current]);
        return;
      }
      const i = indexFor(href);
      if (i < 0) return;
      e.preventDefault();
      go(i);
    });

    /* ---------- Back / forward / typed hashes ---------- */
    window.addEventListener("popstate", () => {
      const i = indexFor(location.hash);
      go(i < 0 ? 0 : i, { push: false });
    });

    /* ---------- Edge detection for wheel / swipe / keys ---------- */
    const atEdge = (p: HTMLElement, dir: number, top = p.scrollTop) =>
      dir > 0 ? top + p.clientHeight >= p.scrollHeight - 2 : top <= 1;
    const menuOpen = () => nav?.classList.contains("is-open");

    /* The browser scrolls a page BEFORE wheel listeners run, so the live
       scrollTop can already be at the edge on the very event that got it
       there. Wheel decisions therefore use the position where scrolling
       last came to rest. */
    let restTop = 0;
    let restTimer: number | undefined;
    for (const p of panels) {
      p.addEventListener(
        "scroll",
        () => {
          if (p !== panels[current]) return;
          clearTimeout(restTimer);
          restTimer = window.setTimeout(() => (restTop = p.scrollTop), 160);
        },
        { passive: true },
      );
    }
    const restingAtEdge = (p: HTMLElement, dir: number) =>
      Math.abs(p.scrollTop - restTop) < 2 && atEdge(p, dir, restTop);

    /* Wheel / trackpad: one gesture = at most one page. A gesture only
       turns the page if it STARTED at the page's edge, so scrolling to the
       bottom of a long page (plus trackpad inertia) never skips ahead. */
    let lastWheel = 0;
    let gestureDir = 0;
    let armed = false;
    let fired = false;
    let acc = 0;
    window.addEventListener(
      "wheel",
      (e) => {
        if (e.ctrlKey || menuOpen()) return;
        const dy = e.deltaY * (e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? innerHeight : 1);
        const dir = Math.sign(dy);
        if (!dir) return;
        const now = performance.now();
        if (now - lastWheel > 220 || dir !== gestureDir) {
          gestureDir = dir;
          acc = 0;
          fired = false;
          armed = restingAtEdge(panels[current], dir);
        }
        lastWheel = now;
        if (!armed || fired) return;
        acc += Math.abs(dy);
        if (acc > 40) {
          fired = true;
          go(current + dir);
        }
      },
      { passive: true },
    );

    /* Touch swipe (vertical), same edge rule. */
    let tY = 0;
    let tX = 0;
    let tDown = false;
    let tUp = false;
    let tOn = false;
    window.addEventListener(
      "touchstart",
      (e) => {
        tOn = e.touches.length === 1 && !menuOpen();
        if (!tOn) return;
        tY = e.touches[0].clientY;
        tX = e.touches[0].clientX;
        tDown = atEdge(panels[current], 1);
        tUp = atEdge(panels[current], -1);
      },
      { passive: true },
    );
    window.addEventListener(
      "touchend",
      (e) => {
        if (!tOn) return;
        tOn = false;
        const t = e.changedTouches[0];
        const dy = tY - t.clientY;
        const dx = tX - t.clientX;
        if (Math.abs(dy) < 60 || Math.abs(dy) < Math.abs(dx) * 1.5) return;
        if (dy > 0 && tDown) go(current + 1);
        else if (dy < 0 && tUp) go(current - 1);
      },
      { passive: true },
    );

    /* Keyboard: PageDown/PageUp (and ↓/↑ outside of tabs & fields) at a page edge. */
    window.addEventListener("keydown", (e) => {
      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || menuOpen()) return;
      const t = e.target as HTMLElement;
      if (t.closest("input, textarea, select, [contenteditable], iframe")) return;
      const arrows = e.key === "ArrowDown" || e.key === "ArrowUp";
      if (arrows && t.closest('[role="tab"], [role="tablist"]')) return;
      const dir = e.key === "PageDown" || e.key === "ArrowDown" ? 1 : e.key === "PageUp" || e.key === "ArrowUp" ? -1 : 0;
      if (!dir) return;
      if (!atEdge(panels[current], dir)) return; // let the page scroll natively first
      e.preventDefault();
      go(current + dir);
    });

    syncChrome();
  }
</script>
