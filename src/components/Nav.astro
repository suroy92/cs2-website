---
/**
 * Sticky nav. Transparent over the intro; frosted once you scroll.
 * Mobile (<640px): hamburger toggles a dropdown panel.
 */
import Icon from "./Icon.astro";

interface Props {
  handle: string;
  /** href is "#section" on the home page, or a page path like "/sens" */
  items: { href: string; label: string; current?: boolean }[];
  /** prefix for home-page anchors when this nav is shown on another page (e.g. "/") */
  home?: string;
}
const { handle, items, home = "" } = Astro.props;
const link = (href: string) => (href.startsWith("#") ? `${home}${href}` : href);

// Split "metron1x" → "metron" + "1x" so the suffix can be red, like the wordmark.
const m = /^(.*?)(1x)$/i.exec(handle);
const [head, tail] = m ? [m[1], m[2]] : [handle, ""];
---

<header class="nav" data-nav>
  <nav class="nav__inner container" aria-label="Primary">
    <a class="nav__brand display" href={link("#top")} aria-label={`${handle} — back to top`}>
      {head}<span class="nav__brand-x">{tail}</span>
    </a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span class="sr-only">Menu</span>
      <Icon name="menu" size={22} class="nav__icon-open" />
      <Icon name="close" size={22} class="nav__icon-close" />
    </button>

    <ul class="nav__menu" id="nav-menu" data-nav-menu>
      {items.map((it) => (
        <li>
          <a class:list={["nav__link", { "is-active": it.current }]} href={link(it.href)} aria-current={it.current ? "page" : undefined}>
            {it.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), backdrop-filter var(--dur) var(--ease);
  }
  .nav.is-scrolled,
  .nav.is-open {
    background: rgba(10, 11, 34, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--border);
  }
  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .nav__brand {
    font-size: 1.625rem;
    text-decoration: none;
    text-shadow: 0 2px 14px rgba(10, 11, 34, 0.6);
    padding: 4px 2px;
  }
  .nav__brand-x { color: var(--moon-red); }
  /* The big intro wordmark is the logo on the first screen; the nav one
     fades in with the frosted bar once you scroll (or open the menu). */
  .nav__brand { transition: opacity var(--dur) var(--ease), visibility var(--dur); }
  .nav:not(.is-scrolled):not(.is-open) .nav__brand { opacity: 0; visibility: hidden; }

  .nav__menu {
    display: flex;
    gap: 4px;
  }
  .nav__link {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    text-shadow: 0 1px 10px rgba(10, 11, 34, 0.7);
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .nav__link:hover { color: var(--cream); background: rgba(185, 166, 255, 0.1); }
  .nav__link.is-active { color: var(--cream); box-shadow: inset 0 -2px 0 var(--moon-red); border-radius: 8px 8px 2px 2px; }

  .nav__toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    background: rgba(10, 11, 34, 0.45);
    color: var(--cream);
  }
  .nav__toggle :global(.nav__icon-close) { display: none; }

  @media (max-width: 639px) {
    .nav__toggle { display: inline-flex; }
    .nav__menu {
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      flex-direction: column;
      padding: 8px var(--gutter) 16px;
      background: rgba(10, 11, 34, 0.94);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      display: none;
    }
    .nav.is-open .nav__menu { display: flex; }
    .nav.is-open :global(.nav__icon-open) { display: none; }
    .nav.is-open :global(.nav__icon-close) { display: block; }
    .nav__link { padding: 14px 8px; font-size: 1.0625rem; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const toggle = nav.querySelector<HTMLButtonElement>("[data-nav-toggle]")!;
  const menu = nav.querySelector<HTMLElement>("[data-nav-menu]")!;

  // Frosted state. In page mode (html.js-panels) PanelRouter sets it per page.
  // Otherwise (plain scrolling fallback) a 1px sentinel 24px from the top is
  // watched with IntersectionObserver — no scroll listener, no layout reads.
  if (!document.documentElement.classList.contains("js-panels")) {
    const sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:24px;left:0;width:1px;height:1px;pointer-events:none";
    document.body.prepend(sentinel);
    new IntersectionObserver(([en]) => nav.classList.toggle("is-scrolled", !en.isIntersecting)).observe(sentinel);
  }

  // Mobile menu
  const setOpen = (open: boolean) => {
    nav.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
  };
  toggle.addEventListener("click", () => setOpen(!nav.classList.contains("is-open")));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && nav.classList.contains("is-open")) {
      setOpen(false);
      toggle.focus();
    }
  });

  // The active-page underline is set by PanelRouter (it knows which page is showing).
</script>
